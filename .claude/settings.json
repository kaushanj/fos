{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm run lint)",
      "Bash(npm run typecheck)",
      "Bash(npm run format:check)",
      "Bash(npm test)",
      "Bash(npm test -- *)",
      "Bash(npm run check)"
    ],
    "ask": ["Bash(git push *)", "Bash(git * push *)", "mcp__atlassian__*"],
    "disableBypassPermissionsMode": "disable"
  }
}
